# Optional RideWorks settings. Copy to .env; keep .env out of Git.
# CLI flags win, then exported environment, then this file, then defaults.
FLASK_DEBUG=0
FLASK_RUN_PORT=8765
RIDEWORKS_DATA_DIR=local_data/p1-03-review
# FLASK_DEBUG enables request timing/status diagnostics only.
# RideWorks uses stdlib HTTP: no Flask debugger or automatic reloader.

# Optional Strava app credentials for Settings > Strava connect/manual sync.
# Copy this example to ignored .env and enter your app's values there.
# Strava API settings > Authorization Callback Domain: 127.0.0.1 (host only).
# Web callback uses the running app port: http://127.0.0.1:<port>/strava/callback
# Review app port 8771; secondary CLI callback defaults to port 8772.
# Exported STRAVA_CLIENT_ID / STRAVA_CLIENT_SECRET override these entries.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
